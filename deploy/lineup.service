# /etc/systemd/system/lineup.service
# sudo systemctl daemon-reload && sudo systemctl enable --now lineup
[Unit]
Description=Lineup online game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lineup
Group=lineup
WorkingDirectory=/opt/lineup
EnvironmentFile=-/etc/lineup/lineup.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=always
RestartSec=3
# The server stops accepting connections and notifies clients on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/lineup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
