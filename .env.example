# Copy to /etc/lineup/lineup.env (systemd) or pass to docker. All values are optional.
NODE_ENV=production
PORT=3001
# Bind to localhost when a reverse proxy (nginx/Caddy) runs on the same machine.
HOST=127.0.0.1
# Static files directory; relative paths resolve from apps/server.
WEB_DIST=../web/dist
# Only needed if the web app is served from a different origin (comma-separated list).
# CORS_ORIGIN=https://play.example.com
LOG_LEVEL=info
# 1 = trust X-Forwarded-For from the reverse proxy (needed for per-IP rate limits).
TRUST_PROXY=1
# Rooms one IP may create per minute (default 5).
# ROOM_CREATE_LIMIT=5
# Milliseconds a disconnected host keeps the host role before it passes on (default 30000 = 30 s).
# HOST_GRACE_MS=30000
# Never enable in production; the server refuses to start with TEST_MODE=1 and NODE_ENV=production.
TEST_MODE=0
